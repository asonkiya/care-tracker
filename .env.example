# Required
DASHBOARD_PASSWORD=pick-a-long-password
ANTHROPIC_API_KEY=sk-ant-...
DATA_DIR=/data                 # must be the Railway volume mount path

# Optional
TRACK_GROUP_NAME=              # auto-pick the group whose name contains this text
MODEL=claude-sonnet-5-5        # claude-haiku-5-5 is cheaper
TZ_NAME=Asia/Kolkata
DEBOUNCE_SECONDS=90            # wait this long after the last message before processing
BACKFILL_DAYS=45               # how much past history to organise on first link
